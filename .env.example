HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen2.5-72B-Instruct

# Groq (gratuito) - usado em vez da HuggingFace quando GROQ_API_KEY está
# definido. Cria uma key em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.1-8b-instant

# Pasta raiz "...Documentos" sincronizada do OneDrive (só leitura, nunca
# escrita). Usada para atualizar os dados automaticamente (POST /atualizar-dados).
ONEDRIVE_RAIZ=

# Pasta "logs" dos scripts agendados (preencher_mapa.py, etc.) que correm
# fora do Docker, na mesma máquina. O serviço scripts-log do docker-compose
# lê-a (só leitura) e mostra o conteúdo no Dozzle (log-viewer).
SCRIPTS_LOG_DIR=
