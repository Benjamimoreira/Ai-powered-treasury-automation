# LLM local (Ollama) - sugestões, agente e Assistente. Nenhum dado sai da
# máquina (ver docs/AVALIACAO_LLM.md e docs/GOVERNANCA_IA.md). Instalar o
# Ollama (ollama.com) e descarregar o modelo: ollama pull qwen2.5:3b
LLM_FORNECEDOR=ollama
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL_ID=qwen2.5:3b

# Tracing das chamadas ao LLM no Arize Phoenix (no docker-compose já vem
# definido para o serviço phoenix). Vazio = sem tracing.
PHOENIX_COLLECTOR_ENDPOINT=

# Tracing no LangSmith (opcional, independente do Phoenix): o grafo do
# agente e cada chamada ao LLM, com tokens e custo. É um serviço externo -
# usar a região da UE (RGPD, ver docs/GOVERNANCA_IA.md).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tesouraria
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Pasta raiz "...Documentos" sincronizada do OneDrive (só leitura, nunca
# escrita). Usada para atualizar os dados automaticamente (POST /atualizar-dados).
ONEDRIVE_RAIZ=

# Pasta "Fornecedores" (fora do Docker) onde ficam arquivadas as faturas
# recebidas - usada para servir o PDF por HTTP (GET /faturas/recebidas/{id}/pdf).
FORNECEDORES_RAIZ=

# Pasta "logs" dos scripts agendados (preencher_mapa.py, etc.) que correm
# fora do Docker, na mesma máquina. O serviço scripts-log do docker-compose
# lê-a (só leitura) e mostra o conteúdo no Dozzle (log-viewer).
SCRIPTS_LOG_DIR=

# Logs dos scripts de faturas (pasta Fornecedores) - mount à parte, porque
# vivem numa pasta diferente de SCRIPTS_LOG_DIR (tesouraria preenchimento).
SCRIPTS_LOG_DIR_FATURAS=

# Pasta do projeto "tesouraria preenchimento" (preencher_mapa.py,
# atualizar_mapa_saldos.py, enviar_mapa_smtp.py) - usada pelo botão "Correr"
# da monitorização para disparar um script em falha. Só funciona quando a
# API corre nativamente na mesma máquina desses scripts (não em Docker). Por
# omissão deriva-se de SCRIPTS_LOG_DIR (pasta pai); só definir se for diferente.
SCRIPTS_PREENCHIMENTO_RAIZ=

# Python do venv desse projeto, usado para correr os scripts acima. Por
# omissão usa "<SCRIPTS_PREENCHIMENTO_RAIZ>/.venv/Scripts/python.exe".
SCRIPTS_PREENCHIMENTO_PYTHON=

# Mesma pasta que ONEDRIVE_RAIZ, mas com barras normais - é a que o Docker
# Desktop consegue usar como origem de um bind mount (o valor com barras
# invertidas de ONEDRIVE_RAIZ é só para os scripts que correm nativos no
# Windows, fora do Docker). Montada em /onedrive só-leitura no container api.
ONEDRIVE_RAIZ_DOCKER=

# Pasta Fornecedores (barras normais, para bind mount) - montada em
# /fornecedores só-leitura no container api, para poder servir os PDFs das
# faturas por HTTP.
FORNECEDORES_RAIZ_DOCKER=

# SMTP para o alerta automático de auditoria (app/services/alertas.py):
# enviado sempre que /auditoria/{dia}/registar ou /auditoria/geral encontram
# movimentos do extrato sem linha correspondente no Mapa (ou vice-versa).
# Sem SMTP_HOST definido, o alerta é ignorado (nunca falha a auditoria).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Por omissão vai para benjamim.moreira@vidor.pt; só definir para mudar.
SMTP_ALERTA_PARA=

# Índice do Departamento Comercial (CPCVs/Escrituras), para a tabela
# "CPCVs / Escrituras do período" (aba Análise de Extratos). Duas opções:
# - COMERCIAL_INDICE_PATH: caminho para o .xlsx numa pasta do SharePoint
#   (site DEPTCOMERCIAL) sincronizada com o OneDrive desta máquina
#   ("Adicionar atalho ao OneDrive" no SharePoint) - atualiza-se sozinho,
#   sem download manual nenhum. Preferida quando definida.
# - COMERCIAL_INDICE_CSV (antiga): caminho para um .csv exportado à mão do
#   SharePoint - requer descarregar de novo sempre que se quiserem dados
#   atualizados. Por omissão (nenhuma das duas definida) usa o último
#   ficheiro conhecido em Downloads.
COMERCIAL_INDICE_PATH=
COMERCIAL_INDICE_CSV=

# Para o Docker (container api): pasta que contém o ficheiro acima
# (montada só-leitura como /comercial) e o nome do ficheiro dentro dela -
# juntos formam o COMERCIAL_INDICE_PATH usado dentro do container (ver
# docker-compose.yml). Sem barras invertidas (mesma convenção de
# ONEDRIVE_RAIZ_DOCKER/FORNECEDORES_RAIZ_DOCKER).
COMERCIAL_INDICE_RAIZ_DOCKER=
COMERCIAL_INDICE_NOME=
