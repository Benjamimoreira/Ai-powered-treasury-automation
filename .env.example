HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen2.5-72B-Instruct

# Groq (gratuito) - usado em vez da HuggingFace quando GROQ_API_KEY está
# definido. Cria uma key em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.1-8b-instant

# Pasta raiz "...Documentos" sincronizada do OneDrive (só leitura, nunca
# escrita). Usada para atualizar os dados automaticamente (POST /atualizar-dados).
ONEDRIVE_RAIZ=

# Pasta "Fornecedores" (fora do Docker) onde ficam arquivadas as faturas
# recebidas - usada para servir o PDF por HTTP (GET /faturas/recebidas/{id}/pdf).
FORNECEDORES_RAIZ=

# Pasta "logs" dos scripts agendados (preencher_mapa.py, etc.) que correm
# fora do Docker, na mesma máquina. O serviço scripts-log do docker-compose
# lê-a (só leitura) e mostra o conteúdo no Dozzle (log-viewer).
SCRIPTS_LOG_DIR=

# Logs dos scripts de faturas (pasta Fornecedores) - mount à parte, porque
# vivem numa pasta diferente de SCRIPTS_LOG_DIR (tesouraria preenchimento).
SCRIPTS_LOG_DIR_FATURAS=

# Mesma pasta que ONEDRIVE_RAIZ, mas com barras normais - é a que o Docker
# Desktop consegue usar como origem de um bind mount (o valor com barras
# invertidas de ONEDRIVE_RAIZ é só para os scripts que correm nativos no
# Windows, fora do Docker). Montada em /onedrive só-leitura no container api.
ONEDRIVE_RAIZ_DOCKER=

# Pasta Fornecedores (barras normais, para bind mount) - montada em
# /fornecedores só-leitura no container api, para poder servir os PDFs das
# faturas por HTTP.
FORNECEDORES_RAIZ_DOCKER=
